{
  "name": "trough",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-to-agent (and human) coordination over IRC: cards, stewards and recipes",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "trough": "./src/cli.ts"
  },
  "scripts": {
